#include <windows.h>

1 VERSIONINFO
 FILEVERSION @VERSION_COMMAS@,0
 PRODUCTVERSION @VERSION_COMMAS@,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "G's Cyberpunk 2077 Optimizer\0"
            VALUE "FileDescription", "G's Cyberpunk 2077 Total Optimizer Launcher\0"
            VALUE "FileVersion", "@VERSION_DOTS@.0\0"
            VALUE "ProductName", "G's Cyberpunk 2077 Total Optimizer\0"
            VALUE "ProductVersion", "@VERSION_DOTS@\0"
            VALUE "OriginalFilename", "Gs-Cyberpunk2077_Optimizer.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
