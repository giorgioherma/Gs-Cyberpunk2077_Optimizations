<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>G-Total-Optimizer.App</AssemblyName>
    <!-- One owner-supplied hybrid ICO also embedded by the native launcher. -->
    <ApplicationIcon>../../assets/icons/GOT_LAG_final/GOT_LAG_Hybrid_16-24_brush_32plus_V.ico</ApplicationIcon>
    <RootNamespace>GTotalOptimizer.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Retain legacy form in git for comparison; ship only WPF controls. -->
    <Compile Remove="MainForm.cs" />
    <!-- Win32 EXE icon covers Explorer; WPF pack resource covers the
         titlebar, taskbar, and owned dialogs without runtime file paths. -->
    <Resource Include="../../assets/icons/GOT_LAG_final/GOT_LAG_Hybrid_16-24_brush_32plus_V.ico" Link="Icons/GOT_LAG.ico" />
    <!-- OFL-licensed typefaces from the owner's assets, embedded by WPF.
         Only the weights used in the UI are embedded (no runtime installation). -->
    <Resource Include="../../assets/ui/fonts/Rajdhani/Rajdhani-Regular.ttf" Link="Fonts/Rajdhani/Rajdhani-Regular.ttf" />
    <Resource Include="../../assets/ui/fonts/Rajdhani/Rajdhani-SemiBold.ttf" Link="Fonts/Rajdhani/Rajdhani-SemiBold.ttf" />
    <Resource Include="../../assets/ui/fonts/Rajdhani/Rajdhani-Bold.ttf" Link="Fonts/Rajdhani/Rajdhani-Bold.ttf" />
    <Resource Include="../../assets/ui/fonts/Oxanium/static/Oxanium-Regular.ttf" Link="Fonts/Oxanium/Oxanium-Regular.ttf" />
    <Resource Include="../../assets/ui/fonts/Oxanium/static/Oxanium-SemiBold.ttf" Link="Fonts/Oxanium/Oxanium-SemiBold.ttf" />
    <Resource Include="../../assets/ui/fonts/Oxanium/static/Oxanium-Bold.ttf" Link="Fonts/Oxanium/Oxanium-Bold.ttf" />
    <!-- Owner-supplied native WPF status vector geometry, embedded as BAML. -->
    <Page Include="../../assets/ui/elements/GcoStatusIcons.xaml"
          Link="Status/GcoStatusIcons.xaml" />
    <!-- SVG artwork remains vector in WPF; SharpVectors 1.8.6 supports .NET 10. -->
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
    <Resource Include="../../assets/ui/elements/GCO_Active_Yellow_Button_v2.9.svg"
              Link="StageButtons/GCO_Active_Yellow_Button_v2.9.svg" />
    <Resource Include="../../assets/ui/elements/GCO_Inactive_Button_v3.3.svg"
              Link="StageButtons/GCO_Inactive_Button_v3.3.svg" />
    <Resource Include="../../assets/ui/elements/GCO_Restore_Profilers_Button_v1.4.svg"
              Link="StageButtons/GCO_Restore_Profilers_Button_v1.4.svg" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <ProjectReference Include="../GTotalOptimizer.Core/GTotalOptimizer.Core.csproj" />
  </ItemGroup>
</Project>
