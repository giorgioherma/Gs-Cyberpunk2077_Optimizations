<Window x:Class="GTotalOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="G's Cyberpunk 2077 Optimizer" Width="1380" Height="890"
        MinWidth="1020" MinHeight="690" WindowStartupLocation="CenterScreen"
        Background="#070B0D" Foreground="#F1F5F6" FontFamily="Segoe UI"
        Loaded="Window_Loaded" Activated="Window_Activated" Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="Yellow" Color="#FFF000"/>
        <SolidColorBrush x:Key="Cyan" Color="#00E2F2"/>
        <SolidColorBrush x:Key="Muted" Color="#A7B5BE"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0E171C"/>
            <Setter Property="Foreground" Value="#FFF000"/>
            <Setter Property="BorderBrush" Value="#72712C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#00E2F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#69777A"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#303B42"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#151C20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MinorButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#00E2F2"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="PathInput" TargetType="TextBox">
            <Setter Property="Background" Value="#0C1418"/>
            <Setter Property="Foreground" Value="#F5F5ED"/>
            <Setter Property="BorderBrush" Value="#41515A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CaretBrush" Value="#FFF000"/>
        </Style>
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#0C1519"/>
            <Setter Property="BorderBrush" Value="#394953"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="255"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The original user-supplied 743x2117 images are layered, never repainted. -->
        <Grid Grid.Column="0" ClipToBounds="True" Background="#05090B">
            <Border BorderBrush="#284452" BorderThickness="0,0,2,0"/>
            <Image x:Name="VColorImage" Stretch="UniformToFill" StretchDirection="Both"/>
            <Image x:Name="VBlackImage" Stretch="UniformToFill" StretchDirection="Both" Opacity="1"/>
            <Rectangle VerticalAlignment="Top" Height="170">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C0070B0D" Offset="0"/>
                        <GradientStop Color="#00070B0D" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel VerticalAlignment="Top" Margin="20,24,10,0">
                <TextBlock Text="GCO" Foreground="#FFF000" FontSize="39" FontWeight="Black"/>
                <TextBlock Text="SYSTEM OPTIMIZATION" Foreground="#00E2F2"
                           FontSize="10" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,20">
                <TextBlock Text="CET  /  REDscript" Foreground="#FFF000"
                           FontWeight="Bold" FontSize="11"/>
                <TextBlock Text="MEASURE. ANALYZE. OPTIMIZE." Foreground="#00E2F2"
                           FontSize="9" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="164"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" ClipToBounds="True" Background="#101A20">
                <!-- The BLUE city is a detail cropped from the approved combined mockup,
     never a stretched full-width yellow skyline banner. -->
                <Image x:Name="CityImage" Width="150" Height="160" Stretch="Uniform"
                       Opacity=".98" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,8,0" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F0070B0D" Offset="0"/>
                            <GradientStop Color="#BB070B0D" Offset=".56"/>
                            <GradientStop Color="#10070B0D" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Grid Margin="24,12,24,12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="G'S CYBERPUNK 2077 OPTIMIZER"
                                   Foreground="#FFF000" FontSize="24" FontWeight="Black"/>
                        <TextBlock Text="Capture evidence. Find wasted work. Generate a safer optimization plan."
                                   Foreground="#A7B5BE" FontSize="12" Margin="0,7,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                        <Border BorderThickness="0,0,0,2" BorderBrush="#FFF000" Padding="8,5">
                            <TextBlock Text="1   CAPTURE" Foreground="#FFF000" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="2   ANALYZE &amp; OPTIMIZE" Foreground="#687781"
                                   Margin="14,5,0,0" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="CapturePage" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,12,20,18">
                    <Border Style="{StaticResource CardPanel}" BorderBrush="#FFF000">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="GAME ROOT  /  CYBERPUNK 2077" Foreground="#FFF000"
                                           FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                <Button x:Name="RefreshButton" Content="⟳  REFRESH" HorizontalAlignment="Right"
                                        Style="{StaticResource MinorButton}" Click="Refresh_Click"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="92"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GamePathBox" Grid.Column="0" Style="{StaticResource PathInput}"
                                         TextChanged="GamePath_Changed"/>
                                <Button x:Name="BrowseButton" Grid.Column="1" Content="OPEN"
                                        Style="{StaticResource MinorButton}" Click="Browse_Click"/>
                            </Grid>
                            <Grid Margin="0,8,0,3">
                                <TextBlock x:Name="ModCountText" Foreground="#F1F5F6"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="DIRECT" Foreground="#FFF000" FontSize="11"
                                               FontWeight="Bold" Margin="0,0,16,0"/>
                                    <TextBlock Text="MO2  ·  LATER" Foreground="#64757E" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="DependencyText" Foreground="#FFCF62" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="RECORD 5–10 MINUTES IN THE CITY" Foreground="#00E2F2"
                                       FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="IDLE  ·  WALKING  ·  DRIVING  ·  HEAVY COMBAT"
                                       Foreground="#FFF000" FontWeight="SemiBold" Margin="0,7,0,0"/>
                            <TextBlock Text="Press F11 to start/stop CET and REDscript. PresentMon records automatically. Avoid menus; shorter captures also work."
                                       Foreground="#B8C3C9" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="01" Foreground="#FFF000" FontSize="22" FontWeight="Black"/>
                                <TextBlock Text="INSTALL PROFILERS" Foreground="#FFF000" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Verify supported native profiling tools"
                                           Foreground="#A7B5BE" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="7,0,7,0">
                            <StackPanel>
                                <TextBlock Text="02" Foreground="#FFF000" FontSize="22" FontWeight="Black"/>
                                <TextBlock Text="START CAPTURE" Foreground="#FFF000" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Launch the game and record a varied run"
                                           Foreground="#A7B5BE" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardPanel}" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="03" Foreground="#FFF000" FontSize="22" FontWeight="Black"/>
                                <TextBlock Text="COLLECT RESULTS" Foreground="#FFF000" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Close the game; verify and preserve results"
                                           Foreground="#A7B5BE" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0" BorderBrush="#315362">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TOOL STATUS" Foreground="#00E2F2" FontWeight="Bold" FontSize="12"/>
                                <TextBlock x:Name="CetStatusText" Text="CET   ·   checking" Foreground="#D0E3E8" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                <TextBlock x:Name="RedStatusText" Text="REDscript   ·   checking"
                                           Foreground="#D0E3E8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <TextBlock x:Name="PresentStatusText" Text="PresentMon   ·   optional"
                                           Foreground="#D0E3E8"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="InstallButton" Content="1  INSTALL PROFILERS"
                                Style="{StaticResource ActionButton}" Click="Install_Click" IsEnabled="False"/>
                        <Button Grid.Column="1" x:Name="LaunchButton" Content="2  START CYBERPUNK"
                                Style="{StaticResource ActionButton}" Click="Launch_Click" IsEnabled="False"/>
                        <Button Grid.Column="2" x:Name="CollectButton" Content="3  COLLECT RESULTS"
                                Style="{StaticResource ActionButton}" Click="Collect_Click" IsEnabled="False"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Foreground="#B8C3C9" FontSize="11" TextWrapping="Wrap"
                                       Text="Select the Cyberpunk 2077 game folder."/>
                            <Button x:Name="RestoreButton" Content="RESTORE ORIGINALS / RECOVERY"
                                    HorizontalAlignment="Left" Style="{StaticResource MinorButton}"
                                    Margin="0,6,0,0" Visibility="Collapsed" Click="Restore_Click"/>
                        </StackPanel>
                        <Button x:Name="ContinueButton" Grid.Column="1" Content="CONTINUE →"
                                Background="#FFF000" Foreground="#080D12" BorderBrush="#FFF000"
                                Style="{StaticResource ActionButton}" Click="Continue_Click" IsEnabled="False"/>
                    </Grid>
                    <CheckBox x:Name="ReduceMotionCheck" Content="Reduce flashing animation" IsChecked="False"
                              Foreground="#8FA4B1" HorizontalAlignment="Right" Margin="0,14,4,0"
                              Checked="ReduceMotion_Changed" Unchecked="ReduceMotion_Changed"/>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="ResultsPage" Grid.Row="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18">
                        <TextBlock Text="ANALYZE &amp; OPTIMIZE" Foreground="#FFF000"
                                   FontSize="26" FontWeight="Black"/>
                        <TextBlock x:Name="ResultsStatusText" Foreground="#00E2F2"
                                   TextWrapping="Wrap" FontSize="12" Margin="0,9,0,0"/>
                        <Border Style="{StaticResource CardPanel}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="CET   /   LUA  ·  NATIVE  ·  G-GC"
                                           Foreground="#FFF000" FontWeight="Bold" FontSize="14"/>
                                <TextBox x:Name="CetReportText" Text="No verified CET capture analyzed."
                                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         Background="#0C1519" Foreground="#B7CED6" BorderThickness="0"
                                         MinHeight="108" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="REDscript   /   CALLSITES  ·  COMPILATION"
                                           Foreground="#FFF000" FontWeight="Bold" FontSize="14"/>
                                <TextBox x:Name="RedReportText" Text="No verified REDscript capture analyzed."
                                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         Background="#0C1519" Foreground="#B7CED6" BorderThickness="0"
                                         MinHeight="108" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AnalyzeButton" Grid.Column="0" Content="ANALYZE"
                                    Style="{StaticResource ActionButton}" IsEnabled="False"/>
                            <Button x:Name="GenerateButton" Grid.Column="1" Content="GENERATE ZIP"
                                    Style="{StaticResource ActionButton}" IsEnabled="False"/>
                            <Button x:Name="OpenResultsButton" Grid.Column="2" Content="OPEN RESULTS"
                                    Style="{StaticResource ActionButton}" IsEnabled="False"
                                    Click="OpenResults_Click"/>
                        </Grid>
                        <TextBlock Text="Generator actions remain disabled until source-aware CET/REDscript backend and compile checks are implemented."
                                   Foreground="#98A9B1" TextWrapping="Wrap" FontSize="11" Margin="6,13,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>