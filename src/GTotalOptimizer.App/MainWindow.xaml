<Window x:Class="GTotalOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fx="clr-namespace:GTotalOptimizer.App.Visuals"
        Title="G's Cyberpunk 2077 Optimizer"
        Icon="pack://application:,,,/Icons/GOT_LAG.ico"
        Width="1280" Height="760" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#000000" Foreground="#F1F5F6"
        FontFamily="./Fonts/Rajdhani/#Rajdhani" FontSize="14"
        Loaded="Window_Loaded" Activated="Window_Activated"
        SizeChanged="Window_SizeChanged" Closed="Window_Closed">
    <Window.Resources>
        <FontFamily x:Key="Rajdhani">./Fonts/Rajdhani/#Rajdhani</FontFamily>
        <FontFamily x:Key="Oxanium">./Fonts/Oxanium/#Oxanium</FontFamily>
        <SolidColorBrush x:Key="Yellow" Color="#FFF000"/>
        <SolidColorBrush x:Key="Cyan" Color="#00E2F2"/>
        <SolidColorBrush x:Key="Muted" Color="#A8B3B5"/>
        <LinearGradientBrush x:Key="NeonStroke" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFF000" Offset="0"/>
            <GradientStop Color="#FFF000" Offset=".48"/>
            <GradientStop Color="#00E2F2" Offset=".53"/>
            <GradientStop Color="#00E2F2" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NeonTop" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFF000" Offset="0"/>
            <GradientStop Color="#FFF000" Offset=".21"/>
            <GradientStop Color="#00D9F5" Offset=".83"/>
            <GradientStop Color="#00D9F5" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#151C1C"/>
            <Setter Property="Foreground" Value="#FFF000"/>
            <Setter Property="BorderBrush" Value="#858A28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource Oxanium}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="ButtonFrame"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.5"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFrame" Property="BorderBrush" Value="#00E2F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#788588"/>
                                <Setter TargetName="ButtonFrame" Property="BorderBrush" Value="#304347"/>
                                <Setter TargetName="ButtonFrame" Property="Background" Value="#10191B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MinorButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#00E2F2"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="PathInput" TargetType="TextBox">
            <Setter Property="Background" Value="#11191A"/>
            <Setter Property="Foreground" Value="#F2F5F5"/>
            <Setter Property="BorderBrush" Value="#42616A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="CaretBrush" Value="#FFF000"/>
            <!-- Native rectangular WPF field: no chamfer clipping and no
                 background leaking from behind the cut-corner parent. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="PathFrame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PathFrame" Property="BorderBrush" Value="#FFF000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PathFrame" Property="Background" Value="#10191B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallStatus" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Rajdhani}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B3C5CB"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="#081012"/>
            <Setter Property="BorderBrush" Value="#36535B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="ContinueStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#071012"/>
            <Setter Property="Background" Value="#FFF000"/>
            <Setter Property="FontFamily" Value="{StaticResource Oxanium}"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ContinueShape" Background="{TemplateBinding Background}"
                                    BorderBrush="#E8D800" BorderThickness="2.1"/>
                            <ContentPresenter Margin="15,2,9,2"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ContinueShape" Property="BorderBrush" Value="#00E2F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#718386"/>
                                <Setter TargetName="ContinueShape" Property="Background" Value="#182527"/>
                                <Setter TargetName="ContinueShape" Property="BorderBrush" Value="#36565F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Minimal neon yellow scroll indicator; maintain functional track,
             thumb, keyboard scrolling and dark #000000 background. -->
        <Style x:Key="NeonScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="#000000" Width="10">
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="3" HorizontalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Width="3" CornerRadius="1"
                                                        Background="#FFF000"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- Compact default window: 1280x760 DIPs. At 1080x640 the right
         content scrolls rather than clipping; native profilers are unaffected. -->
    <Grid Background="#000000" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The original alpha PNG is the final/frontmost perimeter;
             its painted corners always cover the portrait and the inner line. -->
        <Image x:Name="OuterBorderArtwork" Grid.RowSpan="2"
               Panel.ZIndex="30"
               Stretch="Fill" StretchDirection="Both"
               IsHitTestVisible="False" SnapsToDevicePixels="True"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- Keep the title/header TRANSPARENT so the artwork's TOP border
             remains visible beneath it. Other UI stays unchanged. -->
        <Grid Grid.Row="0" Background="Transparent" Margin="10,6,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="165"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#DCE000" BorderThickness="0,0,1.5,0"
                    Padding="2,0,15,0" Margin="0,4,15,6">
                <TextBlock Text="GCO" FontFamily="{StaticResource Oxanium}"
                           FontWeight="ExtraBold" Foreground="#FFF000"
                           FontSize="34" VerticalAlignment="Center"
                           ToolTip="Placeholder for the approved GCO logo"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                <TextBlock Text="G's Cyberpunk 2077 Optimizer"
                           Foreground="#F2F5F5" FontFamily="{StaticResource Oxanium}"
                           FontWeight="SemiBold" FontSize="19"/>
                <TextBlock Text="CET  /  REDscript  /  PresentMon"
                           Foreground="#00D9F5" FontWeight="SemiBold" FontSize="11" Margin="1,1,0,0"/>
            </StackPanel>
            <!-- Refresh is always accessible in the top header, not in
                 the game-path panel. The main stage controls stay unchanged. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Margin="0,0,14,0">
                <Button x:Name="RefreshButton" Content="⟳  REFRESH"
                        Style="{StaticResource MinorButton}" Click="Refresh_Click"
                        Margin="0,0,14,0"/>
                <TextBlock Text="v1.1.8" Foreground="#87999F"
                           VerticalAlignment="Center" FontFamily="{StaticResource Oxanium}"
                           FontSize="10"/>
            </StackPanel>
            <!-- The content chassis draws the only header divider. -->
        </Grid>

        <!-- Page indicators float in the clear band ABOVE the thin inner box.
             Kept separate from the scrollable Capture/Analyze content. -->
        <Grid x:Name="TopTabsHost" Grid.Row="0" Panel.ZIndex="22"
              VerticalAlignment="Bottom" Height="44"
              Margin="250,0,29,5" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Grid Width="246" Height="44" Margin="0,0,12,0">
                <fx:SlantedTabShape x:Name="CaptureTabShape"
                                    Fill="#FFF000" Stroke="#FFF000"
                                    StrokeThickness="1.8" IsHitTestVisible="False"/>
                <TextBlock x:Name="CaptureTabLabel" Text="CAPTURE" Foreground="#061014"
                           FontFamily="{StaticResource Oxanium}" FontWeight="Bold"
                           FontSize="18" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
            <Grid Width="246" Height="44">
                <fx:SlantedTabShape x:Name="AnalyzeTabShape"
                                    Fill="#0D171B" Stroke="#91ABB4"
                                    StrokeThickness="1.8" IsHitTestVisible="False"/>
                <TextBlock x:Name="AnalyzeTabLabel" Text="ANALYZE" Foreground="#D8E2E6"
                           FontFamily="{StaticResource Oxanium}" FontWeight="Bold"
                           FontSize="18" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
                    </StackPanel>
        </Grid>

        <!-- Right content remains clipped by its own host. The left V can
             extend slightly into the decorative lower chassis cutout. -->
        <Grid x:Name="ContentRegion" Grid.Row="1" Panel.ZIndex="12" ClipToBounds="False"
              Margin="29,0,29,29" SizeChanged="ContentRegion_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ArtworkColumn" Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Keep the original narrow reserved column; the wider portrait
                 is a separate background layer behind the actual controls. -->
            <Grid Grid.Column="0" Background="Transparent"/>

            <!-- Updated owner skyline is already balanced to pure black. -->
                <!-- Same named new header image, existing 174-DIP skyline slot. -->
            <Grid x:Name="SkylineHost" Grid.Column="1" Panel.ZIndex="0" Height="174"
                      VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                    <Image x:Name="CityImage"
                           Width="{Binding ActualWidth, ElementName=SkylineHost}"
                           Stretch="Uniform" StretchDirection="Both"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           SnapsToDevicePixels="True"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset=".70"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>


            <!-- Owner-painted V alpha now provides the whole yellow-to-black
                 transition. Never add a competing synthetic WPF atmosphere. -->

            <!-- Owner-painted transition is behind controls (Z=2), above the
                     skyline (Z=0), and extends right from unchanged V anchor. -->
            <Grid x:Name="VPortraitHost" Grid.ColumnSpan="2" Panel.ZIndex="1"
                  HorizontalAlignment="Left" Margin="-1,0,0,-6"
                  Width="214" Background="Transparent" ClipToBounds="True"
                  fx:ChamferClip.CornerCut="14">
                <!-- Both 482:928 layers preserve their original painted right fade. -->
                <Grid x:Name="VImageLayers">
                    <Image x:Name="VColorImage" Stretch="Uniform" StretchDirection="Both"
                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Image x:Name="VBlackImage" Stretch="Uniform" StretchDirection="Both"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="1"/>
                </Grid>
                <!-- Only top/side black edges; never draw a dark seam where
                     the portrait's yellow bottom meets the yellow outer border. -->
                <!-- No full-width right-edge outline through the new painted fade. -->
            </Grid>

            <Grid Grid.Column="1" Panel.ZIndex="2" Background="Transparent" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="63"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="CapturePage" Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource NeonScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="15,0,15,4">
                        <!-- Larger hero headline over the blue skyline. -->
                        <StackPanel Margin="0,3,0,12">
                            <TextBlock x:Name="HeroTitle" Margin="22,0,0,0"
                                       FontFamily="{StaticResource Oxanium}" FontSize="19"
                                       FontWeight="Bold" TextWrapping="Wrap" LineHeight="33">
                                <Run Text="GOT LAG? " FontSize="28" FontWeight="ExtraBold"
                                     Foreground="#FFF000"/>
                                <Run Text="Cyberpunk 2077 CET and REDscript Optimizations"
                                     Foreground="#F4F6F6"/>
                            </TextBlock>
                            <TextBlock Text="Capture performance data, analyze it and generate a custom optimization pack."
                                       Foreground="#EDF3F5" FontSize="14.5"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- White heading outside a height-constrained Game Root box. -->
                        <!-- Restore the original Game Root X alignment. -->
                        <StackPanel Margin="0,1,0,9">
                            <Grid Height="27" Margin="2,0,0,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 1,18 L 5,1 M 7,18 L 11,1 M 13,18 L 17,1"
                                          Stroke="#00E2F2" StrokeThickness="2.7"
                                          Width="18" Height="20" Margin="0,0,9,0"/>
                                    <TextBlock Text="GAME ROOT / CYBERPUNK 2077"
                                               Foreground="#F5F6F6" FontFamily="{StaticResource Oxanium}"
                                               FontWeight="Bold" FontSize="15.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <!-- Fixed size prevents Path geometry inflating StackPanel measure. -->
                            <Grid x:Name="GameRootPanel" Height="108" Background="#000000">
                                <fx:ChamferOutline Fill="#000000"
                                                   Stroke="{StaticResource NeonStroke}" StrokeThickness="2.0"
                                                   CornerCut="14" IsHitTestVisible="False"/>
                                <!-- Keep the rectangular input entirely inside the 14-DIP
                                     chamfer clearance at both ends. OPEN gets a 16-DIP gap. -->
                                <StackPanel Margin="22,7,22,6">
                                    <Grid Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="GamePathBox" Grid.Column="0"
                                                 Style="{StaticResource PathInput}"
                                                 TextChanged="GamePath_Changed"/>
                                        <Button x:Name="BrowseButton" Grid.Column="1" Content="OPEN"
                                                Style="{StaticResource MinorButton}" Margin="16,0,0,0"
                                                Click="Browse_Click"/>
                                    </Grid>
                                    <Grid Margin="2,4,2,0" Height="18">
                                        <TextBlock x:Name="ModCountText" Foreground="#F1F5F6"
                                                   FontSize="12.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <TextBlock x:Name="DependencyText" Foreground="#FAD76B"
                                               Height="16" VerticalAlignment="Center"
                                               FontSize="11.5" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    <StackPanel Orientation="Horizontal" Margin="1,1,0,0" Height="16">
                                        <TextBlock x:Name="CetStatusText" Style="{StaticResource SmallStatus}"
                                                   Width="145" Text="CET · checking"/>
                                        <TextBlock x:Name="RedStatusText" Style="{StaticResource SmallStatus}"
                                                   Width="160" Text="REDscript · checking"/>
                                        <TextBlock x:Name="PresentStatusText" Style="{StaticResource SmallStatus}"
                                                   Width="200" Text="PresentMon · optional"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="2,4,0,9" Height="24">
                            <Path Data="M 1,18 L 5,1 M 7,18 L 11,1 M 13,18 L 17,1"
                                  Stroke="#00E2F2" StrokeThickness="2.7"
                                  Width="18" Height="20" Margin="0,0,9,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="CAPTURE WORKFLOW" Foreground="#F5F6F6"
                                       FontFamily="{StaticResource Oxanium}" FontSize="15.5"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Large compact step cards. Buttons are inside each card. -->
                        <Grid Height="204">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,5,0">
                                <fx:ChamferOutline Fill="#081012"
                                                   Stroke="{StaticResource NeonStroke}" StrokeThickness="2.0"
                                                   CornerCut="14" IsHitTestVisible="False"/>
                                <Grid Margin="12,10,12,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="38"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="01" HorizontalAlignment="Left"
                                                   Foreground="#FFF000" FontFamily="{StaticResource Oxanium}"
                                                   FontSize="22" FontWeight="ExtraBold"/>
                                        <Viewbox HorizontalAlignment="Center" Width="38" Height="35">
                                            <Path Data="M 12,1 L 12,19 M 6,13 L 12,19 L 18,13 M 2,21 L 2,26 L 22,26 L 22,21"
                                                  Stroke="#00E2F2" StrokeThickness="2.3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Width="24" Height="28"/>
                                        </Viewbox>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="Install Profilers"
                                               Foreground="#F2F5F5" FontFamily="{StaticResource Oxanium}"
                                               FontWeight="Bold" FontSize="15.5" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Margin="0,4,0,4"
                                               Text="Install the available CET and/or REDscript profiling tools."
                                               Foreground="#A8B3B5" FontSize="13"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="InstallButton" Grid.Row="3" Content="INSTALL PROFILERS"
                                            Style="{StaticResource ActionButton}" Click="Install_Click"
                                            IsEnabled="False"/>
                                </Grid>
                            </Grid>

                            <Grid Grid.Column="1" Margin="5,0,5,0">
                                <fx:ChamferOutline Fill="#081012"
                                                   Stroke="{StaticResource NeonStroke}" StrokeThickness="2.0"
                                                   CornerCut="14" IsHitTestVisible="False"/>
                                <Grid Margin="12,10,12,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="38"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="02" HorizontalAlignment="Left"
                                                   Foreground="#FFF000" FontFamily="{StaticResource Oxanium}"
                                                   FontSize="22" FontWeight="ExtraBold"/>
                                        <Viewbox HorizontalAlignment="Center" Width="41" Height="35">
                                            <Path Data="M 8,6 C 6,6 4,7 3,10 L 1,18 C 0,25 5,27 9,20 L 12,16 L 22,16 L 25,20 C 30,27 35,25 34,18 L 32,10 C 31,7 29,6 27,6 Z M 8,11 L 8,17 M 5,14 L 11,14 M 25,11 L 26,12 M 29,15 L 30,16"
                                                  Stroke="#00E2F2" StrokeThickness="1.8"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                                  Width="35" Height="27"/>
                                        </Viewbox>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="Start Cyberpunk"
                                               Foreground="#F2F5F5" FontFamily="{StaticResource Oxanium}"
                                               FontWeight="Bold" FontSize="15.5" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Margin="0,4,0,4"
                                               Text="Record a varied run: idle, walking, driving and heavy combat."
                                               Foreground="#A8B3B5" FontSize="13"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="LaunchButton" Grid.Row="3" Content="START CYBERPUNK"
                                            Style="{StaticResource ActionButton}" Click="Launch_Click"
                                            IsEnabled="False"/>
                                </Grid>
                            </Grid>

                            <Grid Grid.Column="2" Margin="5,0,0,0">
                                <fx:ChamferOutline Fill="#081012"
                                                   Stroke="{StaticResource NeonStroke}" StrokeThickness="2.0"
                                                   CornerCut="14" IsHitTestVisible="False"/>
                                <Grid Margin="12,10,12,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="38"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="03" HorizontalAlignment="Left"
                                                   Foreground="#FFF000" FontFamily="{StaticResource Oxanium}"
                                                   FontSize="22" FontWeight="ExtraBold"/>
                                        <Viewbox HorizontalAlignment="Center" Width="42" Height="35">
                                            <Path Data="M 2,7 L 18,1 L 34,7 L 18,13 Z M 2,13 L 18,19 L 34,13 M 2,20 L 18,26 L 34,20"
                                                  Stroke="#00E2F2" StrokeThickness="2"
                                                  StrokeLineJoin="Round" Width="36" Height="28"/>
                                        </Viewbox>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="Collect Results"
                                               Foreground="#F2F5F5" FontFamily="{StaticResource Oxanium}"
                                               FontWeight="Bold" FontSize="15.5" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Margin="0,4,0,4"
                                               Text="Close the game. Verify and collect evidence before restoration."
                                               Foreground="#A8B3B5" FontSize="13"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="CollectButton" Grid.Row="3" Content="COLLECT RESULTS"
                                            Style="{StaticResource ActionButton}" Click="Collect_Click"
                                            IsEnabled="False"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Console and recovery never hide behind scrolling content. -->
                <Grid Grid.Row="1" Margin="14,6,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="188"/>
                    </Grid.ColumnDefinitions>
                    <!-- No panel fill/border or second slash: the original V
                         already has a cyan slash here. Keep status/RESTORE alive. -->
                    <Grid x:Name="ConsoleTextHost" Grid.Column="0"
                          Margin="-7,-30,9,19" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Grid.Column="0"
                                   Margin="25,0,0,0"
                                   Foreground="#BFE0E6" FontSize="12.5"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Select the Cyberpunk 2077 game folder."
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <Button x:Name="RestoreButton" Grid.Column="1"
                                Content="RESTORE" Margin="5,0,0,0"
                                Style="{StaticResource MinorButton}" Visibility="Collapsed"
                                Click="Restore_Click"/>
                    </Grid>
                    <Button x:Name="ContinueButton" Grid.Column="1" Content="CONTINUE  →"
                            Style="{StaticResource ContinueStyle}" Click="Continue_Click"
                            IsEnabled="False"/>
                </Grid>

                <Grid x:Name="ResultsPage" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                      Background="#000000" Margin="0,3,0,3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}"
                                   BasedOn="{StaticResource NeonScrollBar}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Margin="18,16">
                            <TextBlock Text="ANALYZE &amp; OPTIMIZE" Foreground="#FFF000"
                                       FontFamily="{StaticResource Oxanium}"
                                       FontSize="23" FontWeight="ExtraBold"/>
                            <TextBlock x:Name="ResultsStatusText" Foreground="#00E2F2"
                                       TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0"/>
                            <Grid Margin="0,12,0,0">
                                <fx:ChamferOutline Fill="#081012" Stroke="#36535B"
                                                   StrokeThickness="2.0" CornerCut="14"
                                                   IsHitTestVisible="False"/>
                                <StackPanel Margin="12">
                                    <TextBlock Text="CET   /   LUA  ·  NATIVE  ·  G-GC"
                                               Foreground="#FFF000" FontFamily="{StaticResource Oxanium}"
                                               FontWeight="Bold" FontSize="14"/>
                                    <TextBox x:Name="CetReportText" Text="No verified CET capture analyzed."
                                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                             Background="#081012" Foreground="#B7CED6" BorderThickness="0"
                                             MinHeight="70" Margin="0,7,0,0"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <fx:ChamferOutline Fill="#081012" Stroke="#36535B"
                                                   StrokeThickness="2.0" CornerCut="14"
                                                   IsHitTestVisible="False"/>
                                <StackPanel Margin="12">
                                    <TextBlock Text="REDscript  /  CALLSITES  ·  COMPILATION"
                                               Foreground="#FFF000" FontFamily="{StaticResource Oxanium}"
                                               FontWeight="Bold" FontSize="14"/>
                                    <TextBox x:Name="RedReportText" Text="No verified REDscript capture analyzed."
                                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                             Background="#081012" Foreground="#B7CED6" BorderThickness="0"
                                             MinHeight="70" Margin="0,7,0,0"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="AnalyzeButton" Grid.Column="0" Content="ANALYZE"
                                        Style="{StaticResource ActionButton}" IsEnabled="False" Margin="0,0,4,0"/>
                                <Button x:Name="GenerateButton" Grid.Column="1" Content="GENERATE ZIP"
                                        Style="{StaticResource ActionButton}" IsEnabled="False" Margin="4,0,4,0"/>
                                <Button x:Name="OpenResultsButton" Grid.Column="2" Content="OPEN RESULTS"
                                        Style="{StaticResource ActionButton}" IsEnabled="False"
                                        Margin="4,0,0,0" Click="OpenResults_Click"/>
                            </Grid>
                            <TextBlock Text="Generation remains disabled until source-aware CET and REDscript compilation checks pass."
                                       Foreground="#98A9B1" TextWrapping="Wrap" FontSize="12"
                                       Margin="3,9,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- The entire V is below the thin inner frame: leave its yellow
             outline visible. ONLY the owner RGBA bottom puddle strip above
             it may cross the line. The original outer raster stays topmost. -->
        <fx:ContentChassisOutline Grid.RowSpan="2" HeaderHeight="68"
                                  Panel.ZIndex="13" FrameInset="27" Stroke="{StaticResource NeonStroke}"
                                  IsHitTestVisible="False"/>

        <!-- Directly register the owner's 365x49 crop with the V 482x928
             source. The strip has its own transparency; no generated mask. -->
        <Grid x:Name="PuddleOverflowHost" Grid.Row="1" Panel.ZIndex="14"
              Width="248" Height="34" HorizontalAlignment="Left"
              VerticalAlignment="Bottom" Margin="28,0,0,23"
              IsHitTestVisible="False" ClipToBounds="True">
            <Image x:Name="PuddleOverflowImage" Stretch="Uniform"
                   StretchDirection="Both" HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>


    </Grid>
</Window>