<Window x:Class="GTotalOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="G's Cyberpunk 2077 Optimizer"
        Width="1220" Height="680" MinWidth="1040" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#060D0F" Foreground="#F1F5F6"
        FontFamily="./Fonts/Rajdhani/#Rajdhani" FontSize="14"
        Loaded="Window_Loaded" Activated="Window_Activated"
        SizeChanged="Window_SizeChanged" Closed="Window_Closed">
    <Window.Resources>
        <FontFamily x:Key="Rajdhani">./Fonts/Rajdhani/#Rajdhani</FontFamily>
        <FontFamily x:Key="Oxanium">./Fonts/Oxanium/#Oxanium</FontFamily>
        <SolidColorBrush x:Key="Yellow" Color="#FFF000"/>
        <SolidColorBrush x:Key="Cyan" Color="#00E2F2"/>
        <SolidColorBrush x:Key="Muted" Color="#A8B3B5"/>
        <LinearGradientBrush x:Key="NeonStroke" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFF000" Offset="0"/>
            <GradientStop Color="#C6CA5F" Offset=".42"/>
            <GradientStop Color="#00D9F5" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NeonTop" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFF000" Offset="0"/>
            <GradientStop Color="#FFF000" Offset=".21"/>
            <GradientStop Color="#00D9F5" Offset=".83"/>
            <GradientStop Color="#00D9F5" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#151C1C"/>
            <Setter Property="Foreground" Value="#FFF000"/>
            <Setter Property="BorderBrush" Value="#858A28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource Oxanium}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFrame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFrame" Property="BorderBrush" Value="#00E2F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#788588"/>
                                <Setter TargetName="ButtonFrame" Property="BorderBrush" Value="#304347"/>
                                <Setter TargetName="ButtonFrame" Property="Background" Value="#10191B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MinorButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#00E2F2"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="PathInput" TargetType="TextBox">
            <Setter Property="Background" Value="#11191A"/>
            <Setter Property="Foreground" Value="#F2F5F5"/>
            <Setter Property="BorderBrush" Value="#42616A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="CaretBrush" Value="#FFF000"/>
        </Style>
        <Style x:Key="SmallStatus" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Rajdhani}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B3C5CB"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="#081012"/>
            <Setter Property="BorderBrush" Value="#36535B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="ContinueStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#071012"/>
            <Setter Property="Background" Value="#FFF000"/>
            <Setter Property="FontFamily" Value="{StaticResource Oxanium}"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Path x:Name="ContinueShape" Fill="{TemplateBinding Background}"
                                  Stroke="#E8D800" StrokeThickness="1.6" Stretch="Fill"
                                  Data="M 18,0 L 1000,0 L 1000,58 L 982,74 L 0,74 L 0,18 Z"/>
                            <ContentPresenter Margin="15,2,9,2"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ContinueShape" Property="Stroke" Value="#00E2F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#718386"/>
                                <Setter TargetName="ContinueShape" Property="Fill" Value="#182527"/>
                                <Setter TargetName="ContinueShape" Property="Stroke" Value="#36565F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- Compact default client area: 1220x680 DIPs. At 1040x600 the right
         content scrolls rather than clipping; native profilers are unaffected. -->
    <Grid Background="#060D0F" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Reserved title/logo band; replace placeholder when user supplies it. -->
        <Grid Grid.Row="0" Background="#060D0F" Margin="16,6,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="165"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#DCE000" BorderThickness="0,0,1.5,0"
                    Padding="2,0,15,0" Margin="0,4,15,6">
                <TextBlock Text="GCO" FontFamily="{StaticResource Oxanium}"
                           FontWeight="ExtraBold" Foreground="#FFF000"
                           FontSize="34" VerticalAlignment="Center"
                           ToolTip="Placeholder for the approved GCO logo"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                <TextBlock Text="G's Cyberpunk 2077 Optimizer"
                           Foreground="#F2F5F5" FontFamily="{StaticResource Oxanium}"
                           FontWeight="SemiBold" FontSize="19"/>
                <TextBlock Text="CET  /  REDscript  /  PresentMon"
                           Foreground="#00D9F5" FontWeight="SemiBold" FontSize="11" Margin="1,1,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="v1.1.5" Foreground="#87999F"
                           HorizontalAlignment="Right" FontFamily="{StaticResource Oxanium}"
                           FontSize="10"/>
                <CheckBox x:Name="ReduceMotionCheck" Content="Reduce flashing"
                          Foreground="#A9B8BB" FontSize="10"
                          HorizontalAlignment="Right" Margin="0,2,0,0"
                          Checked="ReduceMotion_Changed" Unchecked="ReduceMotion_Changed"/>
            </StackPanel>
            <Border Background="{StaticResource NeonTop}" Height="2"
                    VerticalAlignment="Bottom" Grid.ColumnSpan="3" Margin="0,0,0,2"/>
        </Grid>

        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ArtworkColumn" Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Portrait height is authoritative, fit entire 743x2117 canvas without
                 crop; no painted GCO text or overlays obscuring the original. -->
            <Grid Grid.Column="0" Background="#060D0F" ClipToBounds="True">
                <Image x:Name="VColorImage" Stretch="Uniform" StretchDirection="Both"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="VBlackImage" Stretch="Uniform" StretchDirection="Both"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="1"/>
                <Border HorizontalAlignment="Right" Width="1" BorderBrush="#507078"
                        BorderThickness="0,0,1,0" Opacity=".55"/>
            </Grid>

            <Grid Grid.Column="1" Background="#060D0F" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="63"/>
                </Grid.RowDefinitions>
                <!-- Original user full-width 2048x682 skyline, below the title gap.
                     The alpha/dark blue is composited without rectangular borders. -->
                <Image x:Name="CityImage" Grid.RowSpan="2" Stretch="Uniform"
                       StretchDirection="Both" VerticalAlignment="Top"
                       HorizontalAlignment="Stretch" IsHitTestVisible="False"
                       SnapsToDevicePixels="True"/>

                <!-- Two non-navigating status tabs: Page 2 remains restore gated. -->
                <Grid Grid.Row="0" Margin="16,3,16,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Grid Width="215" Height="44" Margin="0,0,8,0">
                            <Path x:Name="CaptureTabShape" Fill="#FFF000" Stroke="#FFF000" StrokeThickness="1.3"
                                  Stretch="Fill" Data="M 17,0 L 1000,0 L 983,100 L 0,100 Z"/>
                            <TextBlock x:Name="CaptureTabLabel" Text="1   CAPTURE" Foreground="#061014"
                                       FontFamily="{StaticResource Oxanium}" FontWeight="Bold"
                                       FontSize="16" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Width="280" Height="44">
                            <Path x:Name="AnalyzeTabShape" Fill="#0D171B" Stroke="#91ABB4" StrokeThickness="1.4"
                                  Stretch="Fill" Data="M 17,0 L 1000,0 L 983,100 L 0,100 Z"/>
                            <TextBlock x:Name="AnalyzeTabLabel" Text="2   ANALYZE &amp; OPTIMIZE" Foreground="#D8E2E6"
                                       FontFamily="{StaticResource Oxanium}" FontWeight="SemiBold"
                                       FontSize="15" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="CapturePage" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="15,0,15,4">
                        <!-- Headline and subtitle are live typography over the skyline. -->
                        <StackPanel Margin="0,6,0,9">
                            <TextBlock FontFamily="{StaticResource Oxanium}"
                                       FontSize="20" FontWeight="ExtraBold"
                                       TextWrapping="Wrap" LineHeight="27">
                                <Run Text="GOT LAG? " Foreground="#FFF000"/>
                                <Run Text="Cyberpunk 2077 CET and REDscript Optimizations"
                                     Foreground="#F4F6F6"/>
                            </TextBlock>
                            <TextBlock Text="Capture performance data, analyze it and generate a custom optimization pack."
                                       Foreground="#EDF3F5" FontSize="14" Margin="0,1,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Game root: counts are global for Direct/MO2; MO2 is gated. -->
                        <Grid Margin="0,0,0,8" Background="#060D0F">
                            <Path Stretch="Fill" Stroke="{StaticResource NeonStroke}"
                                  StrokeThickness="1.15" Fill="#060D0F"
                                  Data="M 12,0 L 994,0 L 1000,9 L 1000,991 L 989,1000 L 6,1000 L 0,993 L 0,12 Z"/>
                            <StackPanel Margin="11,6,11,7">
                                <Grid Margin="0,0,0,3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 1,16 L 7,1 M 10,16 L 16,1 M 19,16 L 25,1"
                                              Stroke="#00E2F2" StrokeThickness="2.6"
                                              Width="27" Height="17" Stretch="None" Margin="0,0,8,0"/>
                                        <TextBlock Text="GAME ROOT  /  CYBERPUNK 2077" FontFamily="{StaticResource Oxanium}"
                                                   Foreground="#FFF000" FontSize="12" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="RefreshButton" Content="⟳  REFRESH"
                                            HorizontalAlignment="Right" Style="{StaticResource MinorButton}"
                                            Click="Refresh_Click"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="73"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="GamePathBox" Grid.Column="0"
                                             Style="{StaticResource PathInput}"
                                             TextChanged="GamePath_Changed"/>
                                    <Button x:Name="BrowseButton" Grid.Column="1" Content="OPEN"
                                            Style="{StaticResource MinorButton}" Margin="6,0,0,0"
                                            Click="Browse_Click"/>
                                </Grid>
                                <Grid Margin="2,5,2,0">
                                    <TextBlock x:Name="ModCountText" Foreground="#F1F5F6"
                                               FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,130,0"/>
                                    <TextBlock Text="DIRECT   /   MO2 LATER"
                                               HorizontalAlignment="Right" Foreground="#8899A2" FontSize="11"/>
                                </Grid>
                                <TextBlock x:Name="DependencyText" Foreground="#FAD76B"
                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <StackPanel Orientation="Horizontal" Margin="1,1,0,0">
                                    <TextBlock x:Name="CetStatusText" Style="{StaticResource SmallStatus}"
                                               Width="145" Text="CET · checking"/>
                                    <TextBlock x:Name="RedStatusText" Style="{StaticResource SmallStatus}"
                                               Width="160" Text="REDscript · checking"/>
                                    <TextBlock x:Name="PresentStatusText" Style="{StaticResource SmallStatus}"
                                               Width="200" Text="PresentMon · optional"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="1,1,0,8" Height="20">
                            <Path Data="M 1,17 L 7,1 M 11,17 L 17,1 M 21,17 L 27,1"
                                  Stroke="#00E2F2" StrokeThickness="2.8" Width="28" Height="19"
                                  Margin="0,0,9,0"/>
                            <TextBlock Text="CAPTURE WORKFLOW" Foreground="#F5F6F6"
                                       FontFamily="{StaticResource Oxanium}" FontSize="14"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Large compact step cards. Buttons are inside each card. -->
                        <Grid Height="204">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,5,0">
                                <Path Fill="#081012" Stroke="{StaticResource NeonStroke}" StrokeThickness="1.3"
                                      Stretch="Fill"
                                      Data="M 12,0 L 984,0 L 1000,16 L 1000,984 L 984,1000 L 12,1000 L 0,984 L 0,12 Z"/>
                                <Grid Margin="12,10,12,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="38"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="01" HorizontalAlignment="Left"
                                                   Foreground="#FFF000" FontFamily="{StaticResource Oxanium}"
                                                   FontSize="22" FontWeight="ExtraBold"/>
                                        <Viewbox HorizontalAlignment="Right" Width="38" Height="35">
                                            <Path Data="M 12,1 L 12,19 M 6,13 L 12,19 L 18,13 M 2,21 L 2,26 L 22,26 L 22,21"
                                                  Stroke="#00E2F2" StrokeThickness="2.3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Width="24" Height="28"/>
                                        </Viewbox>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="Install Profilers"
                                               Foreground="#F2F5F5" FontFamily="{StaticResource Oxanium}"
                                               FontWeight="Bold" FontSize="15.5" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Margin="0,4,0,4"
                                               Text="Install the available CET and/or REDscript profiling tools."
                                               Foreground="#A8B3B5" FontSize="13"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="InstallButton" Grid.Row="3" Content="INSTALL PROFILERS"
                                            Style="{StaticResource ActionButton}" Click="Install_Click"
                                            IsEnabled="False"/>
                                </Grid>
                            </Grid>

                            <Grid Grid.Column="1" Margin="5,0,5,0">
                                <Path Fill="#081012" Stroke="{StaticResource NeonStroke}" StrokeThickness="1.3"
                                      Stretch="Fill"
                                      Data="M 12,0 L 984,0 L 1000,16 L 1000,984 L 984,1000 L 12,1000 L 0,984 L 0,12 Z"/>
                                <Grid Margin="12,10,12,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="38"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="02" HorizontalAlignment="Left"
                                                   Foreground="#FFF000" FontFamily="{StaticResource Oxanium}"
                                                   FontSize="22" FontWeight="ExtraBold"/>
                                        <Viewbox HorizontalAlignment="Right" Width="41" Height="35">
                                            <Path Data="M 8,6 C 6,6 4,7 3,10 L 1,18 C 0,25 5,27 9,20 L 12,16 L 22,16 L 25,20 C 30,27 35,25 34,18 L 32,10 C 31,7 29,6 27,6 Z M 8,11 L 8,17 M 5,14 L 11,14 M 25,11 L 26,12 M 29,15 L 30,16"
                                                  Stroke="#00E2F2" StrokeThickness="1.8"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                                  Width="35" Height="27"/>
                                        </Viewbox>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="Start Cyberpunk"
                                               Foreground="#F2F5F5" FontFamily="{StaticResource Oxanium}"
                                               FontWeight="Bold" FontSize="15.5" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Margin="0,4,0,4"
                                               Text="Record a varied run: idle, walking, driving and heavy combat."
                                               Foreground="#A8B3B5" FontSize="13"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="LaunchButton" Grid.Row="3" Content="START CYBERPUNK"
                                            Style="{StaticResource ActionButton}" Click="Launch_Click"
                                            IsEnabled="False"/>
                                </Grid>
                            </Grid>

                            <Grid Grid.Column="2" Margin="5,0,0,0">
                                <Path Fill="#081012" Stroke="{StaticResource NeonStroke}" StrokeThickness="1.3"
                                      Stretch="Fill"
                                      Data="M 12,0 L 984,0 L 1000,16 L 1000,984 L 984,1000 L 12,1000 L 0,984 L 0,12 Z"/>
                                <Grid Margin="12,10,12,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="38"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="03" HorizontalAlignment="Left"
                                                   Foreground="#FFF000" FontFamily="{StaticResource Oxanium}"
                                                   FontSize="22" FontWeight="ExtraBold"/>
                                        <Viewbox HorizontalAlignment="Right" Width="42" Height="35">
                                            <Path Data="M 2,7 L 18,1 L 34,7 L 18,13 Z M 2,13 L 18,19 L 34,13 M 2,20 L 18,26 L 34,20"
                                                  Stroke="#00E2F2" StrokeThickness="2"
                                                  StrokeLineJoin="Round" Width="36" Height="28"/>
                                        </Viewbox>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="Collect Results"
                                               Foreground="#F2F5F5" FontFamily="{StaticResource Oxanium}"
                                               FontWeight="Bold" FontSize="15.5" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Margin="0,4,0,4"
                                               Text="Close the game. Verify and collect evidence before restoration."
                                               Foreground="#A8B3B5" FontSize="13"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="CollectButton" Grid.Row="3" Content="COLLECT RESULTS"
                                            Style="{StaticResource ActionButton}" Click="Collect_Click"
                                            IsEnabled="False"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Console and recovery never hide behind scrolling content. -->
                <Grid Grid.Row="2" Margin="14,6,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="188"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,9,0">
                        <Path Fill="#081012" Stroke="{StaticResource NeonStroke}"
                              StrokeThickness="1" Stretch="Fill"
                              Data="M 14,0 L 990,0 L 1000,12 L 1000,988 L 985,1000 L 0,1000 L 0,16 Z"/>
                        <Grid Margin="12,6,12,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="27"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M 1,16 L 7,1 M 10,16 L 16,1 M 19,16 L 25,1"
                                  Stroke="#00E2F2" StrokeThickness="2.4"
                                  Width="26" Height="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Grid.Column="1"
                                       Foreground="#BFE0E6" FontSize="12.5"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="Select the Cyberpunk 2077 game folder."
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <Button x:Name="RestoreButton" Grid.Column="2"
                                    Content="RESTORE" Margin="5,0,0,0"
                                    Style="{StaticResource MinorButton}" Visibility="Collapsed"
                                    Click="Restore_Click"/>
                        </Grid>
                    </Grid>
                    <Button x:Name="ContinueButton" Grid.Column="1" Content="CONTINUE  →"
                            Style="{StaticResource ContinueStyle}" Click="Continue_Click"
                            IsEnabled="False"/>
                </Grid>

                <Grid x:Name="ResultsPage" Grid.RowSpan="2" Visibility="Collapsed"
                      Background="#060D0F">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18,16">
                            <TextBlock Text="ANALYZE &amp; OPTIMIZE" Foreground="#FFF000"
                                       FontFamily="{StaticResource Oxanium}"
                                       FontSize="23" FontWeight="ExtraBold"/>
                            <TextBlock x:Name="ResultsStatusText" Foreground="#00E2F2"
                                       TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0"/>
                            <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="CET   /   LUA  ·  NATIVE  ·  G-GC"
                                               Foreground="#FFF000" FontFamily="{StaticResource Oxanium}"
                                               FontWeight="Bold" FontSize="14"/>
                                    <TextBox x:Name="CetReportText" Text="No verified CET capture analyzed."
                                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                             Background="#081012" Foreground="#B7CED6" BorderThickness="0"
                                             MinHeight="70" Margin="0,7,0,0"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelCard}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="REDscript  /  CALLSITES  ·  COMPILATION"
                                               Foreground="#FFF000" FontFamily="{StaticResource Oxanium}"
                                               FontWeight="Bold" FontSize="14"/>
                                    <TextBox x:Name="RedReportText" Text="No verified REDscript capture analyzed."
                                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                             Background="#081012" Foreground="#B7CED6" BorderThickness="0"
                                             MinHeight="70" Margin="0,7,0,0"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="AnalyzeButton" Grid.Column="0" Content="ANALYZE"
                                        Style="{StaticResource ActionButton}" IsEnabled="False" Margin="0,0,4,0"/>
                                <Button x:Name="GenerateButton" Grid.Column="1" Content="GENERATE ZIP"
                                        Style="{StaticResource ActionButton}" IsEnabled="False" Margin="4,0,4,0"/>
                                <Button x:Name="OpenResultsButton" Grid.Column="2" Content="OPEN RESULTS"
                                        Style="{StaticResource ActionButton}" IsEnabled="False"
                                        Margin="4,0,0,0" Click="OpenResults_Click"/>
                            </Grid>
                            <TextBlock Text="Generation remains disabled until source-aware CET and REDscript compilation checks pass."
                                       Foreground="#98A9B1" TextWrapping="Wrap" FontSize="12"
                                       Margin="3,9,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Vector main border, cut corners, mixed yellow-to-cyan neon edge. -->
        <Path Grid.RowSpan="2" Fill="Transparent" Stroke="{StaticResource NeonStroke}"
              StrokeThickness="2" IsHitTestVisible="False" Stretch="Fill" Margin="5"
