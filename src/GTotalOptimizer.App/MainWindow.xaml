<Window x:Class="GTotalOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fx="clr-namespace:GTotalOptimizer.App.Visuals"
        Title="G's Cyberpunk 2077 Optimizer"
        Icon="pack://application:,,,/Icons/GOT_LAG.ico"
        Width="1280" Height="760" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#000000" Foreground="#F1F5F6"
        FontFamily="./Fonts/Rajdhani/#Rajdhani" FontSize="14"
        Loaded="Window_Loaded" Activated="Window_Activated" StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged" Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <FontFamily x:Key="Rajdhani">./Fonts/Rajdhani/#Rajdhani</FontFamily>
        <FontFamily x:Key="Oxanium">./Fonts/Oxanium/#Oxanium</FontFamily>
        <SolidColorBrush x:Key="Yellow" Color="#FFF000"/>
        <SolidColorBrush x:Key="Cyan" Color="#00E2F2"/>
        <SolidColorBrush x:Key="Muted" Color="#A8B3B5"/>
        <!-- Fallback for non-spatial outlines. The framed UI below uses
             one spatial color field anchored to V and the cyan skyline. -->
        <LinearGradientBrush x:Key="NeonStroke" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFF000" Offset="0"/>
            <GradientStop Color="#FFF000" Offset=".48"/>
            <GradientStop Color="#00E2F2" Offset=".53"/>
            <GradientStop Color="#00E2F2" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NeonTop" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFF000" Offset="0"/>
            <GradientStop Color="#FFF000" Offset=".21"/>
            <GradientStop Color="#00D9F5" Offset=".83"/>
            <GradientStop Color="#00D9F5" Offset="1"/>
        </LinearGradientBrush>
        <!-- Layered anodized metal faces: specular/bevel overlay is painted
             separately by ChamferOutline, not by adding image assets. -->
        <LinearGradientBrush x:Key="ButtonMetal" StartPoint=".08,0" EndPoint=".72,1">
            <GradientStop Color="#304A4E" Offset="0"/>
            <GradientStop Color="#1B3339" Offset=".15"/>
            <GradientStop Color="#14262B" Offset=".37"/>
            <GradientStop Color="#0A171B" Offset=".75"/>
            <GradientStop Color="#060D12" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonMetalHot" StartPoint="0,0" EndPoint=".78,1">
            <GradientStop Color="#466C77" Offset="0"/>
            <GradientStop Color="#274D56" Offset=".22"/>
            <GradientStop Color="#15353C" Offset=".55"/>
            <GradientStop Color="#0A1C22" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonMetalPressed" StartPoint="0,0" EndPoint=".8,1">
            <GradientStop Color="#101C22" Offset="0"/>
            <GradientStop Color="#24454A" Offset=".42"/>
            <GradientStop Color="#101F25" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonMetalDark" StartPoint="0,0" EndPoint=".3,1">
            <GradientStop Color="#202E32" Offset="0"/>
            <GradientStop Color="#131F23" Offset=".2"/>
            <GradientStop Color="#0B161B" Offset=".65"/>
            <GradientStop Color="#070F14" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldenMetal" StartPoint=".02,0" EndPoint=".82,1">
            <GradientStop Color="#FFFFC8" Offset="0"/>
            <GradientStop Color="#FFF664" Offset=".17"/>
            <GradientStop Color="#FFF000" Offset=".42"/>
            <GradientStop Color="#BEA300" Offset=".82"/>
            <GradientStop Color="#8D7200" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldenMetalHot" StartPoint="0,0" EndPoint=".75,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FFFFA4" Offset=".22"/>
            <GradientStop Color="#FFF000" Offset=".61"/>
            <GradientStop Color="#D6AE00" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonMetal}"/>
            <Setter Property="Foreground" Value="#FFF000"/>
            <Setter Property="BorderBrush" Value="#858A28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource Oxanium}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <fx:ChamferOutline x:Name="ButtonFrame"
                                               Fill="{TemplateBinding Background}"
                                               Stroke="{TemplateBinding BorderBrush}"
                                               StrokeThickness="1.6" CornerCut="6" MetallicFinish="True" IsHitTestVisible="False"/>
                            <Path x:Name="ButtonTrace" Data="M 0,5 L 6,0 L 26,0"
                                  Stroke="#FFF000" StrokeThickness="1.2" Width="27" Height="6"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Margin="6,1,0,0" IsHitTestVisible="False"/>
                            <Path x:Name="ButtonTail" Data="M 0,5 L 7,5 L 12,0"
                                  Stroke="#00E2F2" StrokeThickness="1.3" Width="13" Height="6"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Margin="0,0,6,1" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFrame" Property="Stroke" Value="#00E2F2"/>
                                <Setter TargetName="ButtonFrame" Property="Fill" Value="{StaticResource ButtonMetalHot}"/>
                                <Setter TargetName="ButtonFrame" Property="Glow" Value="True"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFrame" Property="Fill" Value="{StaticResource ButtonMetalPressed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonFrame" Property="Stroke" Value="#FFF000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#788588"/>
                                <Setter TargetName="ButtonFrame" Property="Stroke" Value="#304347"/>
                                <Setter TargetName="ButtonFrame" Property="Fill" Value="{StaticResource ButtonMetalDark}"/>
                                <Setter TargetName="ButtonFrame" Property="Lit" Value="False"/>
                                <Setter TargetName="ButtonFrame" Property="Glow" Value="False"/>
                                <Setter TargetName="ButtonTrace" Property="Opacity" Value="0.22"/>
                                <Setter TargetName="ButtonTail" Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Owner-standardized 760x112 SVGs: active yellow v2.9, inactive v3.3,
             restore v1.4. One shared shell, uniform scaling, live WPF text. -->
        <Style x:Key="StageActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#090D0F"/>
            <Setter Property="FontFamily" Value="{StaticResource Oxanium}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <fx:ApprovedStageArtwork x:Name="StageArtwork" Variant="Yellow"
                                                     IsHitTestVisible="False"/>
                            <!-- Hover/focus is a separate cyan outline, not another bitmap.
                                 It follows the same chamfer as all three source SVGs. -->
                            <fx:ChamferOutline x:Name="StageHover" Fill="Transparent"
                                               Stroke="#30F2FF" StrokeThickness="2"
                                               CornerCut="7" Glow="True" Opacity="0"
                                               IsHitTestVisible="False">
                                <fx:ChamferOutline.Effect>
                                    <DropShadowEffect Color="#00E2F2" BlurRadius="8"
                                                      ShadowDepth="0" Opacity=".7"/>
                                </fx:ChamferOutline.Effect>
                            </fx:ChamferOutline>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Restore">
                                <Setter TargetName="StageArtwork" Property="Variant" Value="Restore"/>
                                <Setter Property="Foreground" Value="#00DDEB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="StageArtwork" Property="Variant" Value="Unavailable"/>
                                <Setter Property="Foreground" Value="#C8D3DB"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Restore"/>
                                    <Condition Property="IsEnabled" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="StageArtwork" Property="Variant" Value="Unavailable"/>
                                <Setter Property="Foreground" Value="#C8D3DB"/>
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StageHover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StageHover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="StageHover" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StageArtwork" Property="Opacity" Value=".85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RestoreStageButton" TargetType="Button"
               BasedOn="{StaticResource StageActionButton}">
            <Setter Property="Foreground" Value="#00DDEB"/>
            <Setter Property="Tag" Value="Restore"/>
        </Style>
        <Style x:Key="MinorButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#00E2F2"/>
            <Setter Property="BorderBrush" Value="#00AFC4"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="PathInput" TargetType="TextBox">
            <Setter Property="Background" Value="#11191A"/>
            <Setter Property="Foreground" Value="#F2F5F5"/>
            <Setter Property="BorderBrush" Value="#42616A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="CaretBrush" Value="#FFF000"/>
            <!-- One upper-right cut; native text editing and scrolling remain intact. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <fx:ChamferOutline x:Name="PathFrame"
                                               Fill="{TemplateBinding Background}"
                                               Stroke="{TemplateBinding BorderBrush}"
                                               StrokeThickness="1" CornerCut="8"
                                               TopRightOnly="True" IsHitTestVisible="False"/>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PathFrame" Property="Stroke" Value="#FFF000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PathFrame" Property="Fill" Value="#10191B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallStatus" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Rajdhani}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B3C5CB"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="#081012"/>
            <Setter Property="BorderBrush" Value="#36535B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="ContinueStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#071012"/>
            <Setter Property="Background" Value="{StaticResource GoldenMetal}"/>
            <Setter Property="FontFamily" Value="{StaticResource Oxanium}"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <fx:ChamferOutline x:Name="ContinueShape"
                                               Fill="{TemplateBinding Background}"
                                               Stroke="#E8D800" StrokeThickness="2.1"
                                               CornerCut="9" MetallicFinish="True" IsHitTestVisible="False"/>
                            <Path Data="M 0,5 L 7,0 L 25,0" Stroke="#00E2F2"
                                  StrokeThickness="1.6" Width="26" Height="6"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Margin="7,2,0,0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="15,2,9,2"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ContinueShape" Property="Stroke" Value="#00E2F2"/>
                                <Setter TargetName="ContinueShape" Property="Fill" Value="{StaticResource GoldenMetalHot}"/>
                                <Setter TargetName="ContinueShape" Property="Glow" Value="True"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#718386"/>
                                <Setter TargetName="ContinueShape" Property="Fill" Value="{StaticResource ButtonMetalDark}"/>
                                <Setter TargetName="ContinueShape" Property="Lit" Value="False"/>
                                <Setter TargetName="ContinueShape" Property="Glow" Value="False"/>
                                <Setter TargetName="ContinueShape" Property="Stroke" Value="#36565F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Minimal neon yellow scroll indicator; maintain functional track,
             thumb, keyboard scrolling and dark #000000 background. -->
        <Style x:Key="NeonScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="#000000" Width="10">
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="3" HorizontalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Width="3" CornerRadius="1"
                                                        Background="#FFF000"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- Compact default window: 1280x760 DIPs. At 1080x640 the right
         content scrolls rather than clipping; native profilers are unaffected. -->
    <Grid x:Name="RootLayout" Background="#000000" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The original alpha PNG is the final/frontmost perimeter;
             its painted corners always cover the portrait and the inner line. -->
        <Image x:Name="OuterBorderArtwork" Grid.RowSpan="2"
               Panel.ZIndex="30"
               Stretch="Fill" StretchDirection="Both"
               IsHitTestVisible="False" SnapsToDevicePixels="True"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <!-- Official logo aligns its black slope/squares with the raster frame;
             it alone sits ABOVE the original outer PNG and all other UI. -->
        <Image x:Name="GcoHeaderLogo" Grid.RowSpan="2" Panel.ZIndex="50"
               Width="274" Height="76" Margin="19,14,0,0"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Stretch="Fill" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- No app title or subtitle in the top margin; only owner logo and tabs. -->
        <Grid x:Name="TopHeaderHost" Grid.Row="0" Panel.ZIndex="18"
              Background="Transparent" Margin="10,6,10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Margin="0,13,23,0">
                <Button x:Name="RefreshButton" Content="⟳  REFRESH"
                        Style="{StaticResource MinorButton}" Click="Refresh_Click"
                        Height="27" MinWidth="94" Margin="0,0,16,0"/>
                <TextBlock x:Name="BuildVersionText" Foreground="#A7B8BD"
                           VerticalAlignment="Center" FontFamily="{StaticResource Oxanium}"
                           FontSize="11"/>
            </StackPanel>
        </Grid>

        <!-- Center state tabs in the free header space between the actual GCO logo
             right edge and REFRESH left edge; resize alignment uses live bounds. -->
        <Grid x:Name="TopTabsHost" Grid.Row="0" Panel.ZIndex="22"
              VerticalAlignment="Bottom" Height="44"
              IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Grid Width="246" Height="44" Margin="0,0,12,0">
                <fx:SlantedTabShape x:Name="CaptureTabShape" Lit="True"
                                    Fill="{StaticResource GoldenMetal}" Stroke="#FFF000"
                                    StrokeThickness="1.8" IsHitTestVisible="False"/>
                <Path x:Name="CaptureTabMarks" Data="M 0,8 L 6,0 M 10,8 L 16,0 M 20,8 L 26,0"
                      Stroke="#061014" StrokeThickness="2" Width="27" Height="9"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="40,0,0,0" IsHitTestVisible="False"/>
                <Path Data="M 0,0 L 23,0 L 29,6" Stroke="#061014"
                      StrokeThickness="1.3" Width="30" Height="7"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,38,7" IsHitTestVisible="False"/>
                <TextBlock x:Name="CaptureTabLabel" Text="CAPTURE" Foreground="#061014"
                           FontFamily="{StaticResource Oxanium}" FontWeight="Bold"
                           FontSize="18" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
            <Grid Width="246" Height="44">
                <fx:SlantedTabShape x:Name="AnalyzeTabShape" Lit="False"
                                    Fill="{StaticResource ButtonMetalDark}" Stroke="#91ABB4"
                                    StrokeThickness="1.8" IsHitTestVisible="False"/>
                <Path x:Name="AnalyzeTabMarks" Data="M 0,8 L 6,0 M 10,8 L 16,0 M 20,8 L 26,0"
                      Stroke="#00E2F2" StrokeThickness="2" Width="27" Height="9"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="40,0,0,0" IsHitTestVisible="False"/>
                <Path Data="M 0,0 L 23,0 L 29,6" Stroke="#00E2F2"
                      StrokeThickness="1.3" Width="30" Height="7"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,38,7" IsHitTestVisible="False"/>
                <TextBlock x:Name="AnalyzeTabLabel" Text="ANALYZE" Foreground="#D8E2E6"
                           FontFamily="{StaticResource Oxanium}" FontWeight="Bold"
                           FontSize="18" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
                    </StackPanel>
        </Grid>

        <!-- Right content remains clipped by its own host. The left V can
             extend slightly into the decorative lower chassis cutout. -->
        <Grid x:Name="ContentRegion" Grid.Row="1" Panel.ZIndex="12" ClipToBounds="False"
              Margin="29,0,29,29" SizeChanged="ContentRegion_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ArtworkColumn" Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Keep the original narrow reserved column; the wider portrait
                 is a separate background layer behind the actual controls. -->
            <Grid Grid.Column="0" Background="Transparent"/>

            <!-- Updated owner skyline is already balanced to pure black. -->
                <!-- Same named new header image, existing 174-DIP skyline slot. -->
            <Grid x:Name="SkylineHost" Grid.Column="1" Panel.ZIndex="0" Height="174"
                      VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                    <Image x:Name="CityImage"
                           Width="{Binding ActualWidth, ElementName=SkylineHost}"
                           Stretch="Uniform" StretchDirection="Both"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           SnapsToDevicePixels="True"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset=".70"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>


            <!-- Owner-painted V alpha now provides the whole yellow-to-black
                 transition. Never add a competing synthetic WPF atmosphere. -->

            <!-- Owner-painted transition is behind controls (Z=2), above the
                     skyline (Z=0), and extends right from unchanged V anchor. -->
            <Grid x:Name="VPortraitHost" Grid.ColumnSpan="2" Panel.ZIndex="1"
                  HorizontalAlignment="Left" Margin="-1,0,0,-6"
                  Width="214" Background="Transparent" ClipToBounds="True"
                  fx:ChamferClip.CornerCut="14">
                <!-- Both 482:928 layers preserve their original painted right fade. -->
                <Grid x:Name="VImageLayers">
                    <Image x:Name="VColorImage" Stretch="Uniform" StretchDirection="Both"
                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Image x:Name="VBlackImage" Stretch="Uniform" StretchDirection="Both"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="1"/>
                </Grid>
                <!-- Only top/side black edges; never draw a dark seam where
                     the portrait's yellow bottom meets the yellow outer border. -->
                <!-- No full-width right-edge outline through the new painted fade. -->
            </Grid>

            <Grid Grid.Column="1" Panel.ZIndex="2" Background="Transparent" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="88"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="CapturePage" Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource NeonScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="15,0,15,4">
                        <!-- Larger hero headline over the blue skyline. -->
                        <!-- Move title and its description together. -->
                        <StackPanel x:Name="HeroSection" Margin="62,17,0,8">
                            <TextBlock x:Name="HeroTitle" Margin="0"
                                       FontFamily="{StaticResource Oxanium}" FontSize="19"
                                       FontWeight="Bold" TextWrapping="Wrap" LineHeight="33">
                                <Run Text="GOT LAG? " FontSize="28" FontWeight="ExtraBold"
                                     Foreground="#FFF000"/>
                                <Run Text="G's Cyberpunk 2077 CET and REDscript Optimizations"
                                     Foreground="#F4F6F6"/>
                            </TextBlock>
                            <TextBlock x:Name="HeroSubtitle"
                                       Text="Capture performance data, analyze it and generate a custom optimization pack."
                                       Foreground="#EDF3F5" FontSize="14.5"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- White heading outside a height-constrained Game Root box. -->
                        <!-- Restore the original Game Root X alignment. -->
                        <StackPanel Margin="30,12,0,9">
                            <Grid Height="27" Margin="2,0,0,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 1,18 L 5,1 M 7,18 L 11,1 M 13,18 L 17,1"
                                          Stroke="#00E2F2" StrokeThickness="2.7"
                                          Width="18" Height="20" Margin="0,0,9,0"/>
                                     <TextBlock Text="GAME ROOT / CYBERPUNK 2077"
                                               Foreground="#F5F6F6" FontFamily="{StaticResource Oxanium}"
                                               FontWeight="Bold" FontSize="15.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <!-- Fixed size prevents Path geometry inflating StackPanel measure. -->
                            <Grid x:Name="GameRootPanel" Height="108" Background="Transparent">
                                <fx:ChamferOutline x:Name="GameRootOutline" Fill="#000000"
                                                   Stroke="{StaticResource NeonStroke}" SpatialStroke="True"
                                                   StrokeThickness="2.0" CornerCut="14" IsHitTestVisible="False"/>
                                <!-- Keep the rectangular input entirely inside the 14-DIP
                                     chamfer clearance at both ends. OPEN gets a 16-DIP gap. -->
                                <StackPanel x:Name="GameRootContents"
                                            Margin="22,0,22,0" VerticalAlignment="Center">
                                    <Grid Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="GamePathBox" Grid.Column="0"
                                                 Style="{StaticResource PathInput}"
                                                 LostKeyboardFocus="GamePath_LostKeyboardFocus"
                                                 TextChanged="GamePath_Changed"/>
                                        <Button x:Name="BrowseButton" Grid.Column="1" Content="OPEN"
                                                Style="{StaticResource MinorButton}" Margin="16,0,0,0"
                                                Click="Browse_Click"/>
                                    </Grid>
                                    <Grid Margin="2,4,2,0" Height="18">
                                        <TextBlock x:Name="ModCountText" Foreground="#F1F5F6"
                                                   FontSize="12.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <TextBlock x:Name="DependencyText" Foreground="{StaticResource Cyan}"
                                               Height="16" VerticalAlignment="Center"
                                               FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="1,1,0,0" Height="16">
                                        <TextBlock x:Name="CetStatusText" Style="{StaticResource SmallStatus}"
                                                   Width="192" Text="G-CET Profiler · NOT CHECKED"/>
                                        <TextBlock x:Name="RedStatusText" Style="{StaticResource SmallStatus}"
                                                   Width="240" Text="G-REDscript Profiler · NOT CHECKED"/>
                                        <TextBlock x:Name="PresentStatusText" Style="{StaticResource SmallStatus}"
                                                   Width="175" Text="PresentMon · AUTOMATIC"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="CaptureWorkflowHeading" Orientation="Horizontal" Margin="32,15,0,9" Height="24">
                            <Path Data="M 1,18 L 5,1 M 7,18 L 11,1 M 13,18 L 17,1"
                                  Stroke="#00E2F2" StrokeThickness="2.7"
                                  Width="18" Height="20" Margin="0,0,9,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="CAPTURE WORKFLOW" Foreground="#F5F6F6"
                                       FontFamily="{StaticResource Oxanium}" FontSize="15.5"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Large compact step cards. Buttons are inside each card. -->
                        <Grid Height="228" Margin="30,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="19,0,24,0">
                                <fx:ChamferOutline x:Name="StepOneOutline" Fill="#0B1518"
                                                   Stroke="{StaticResource NeonStroke}" SpatialStroke="True"
                                                   StrokeThickness="2.0" CornerCut="14" IsHitTestVisible="False"/>
                                <Grid Margin="12,10,12,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="38"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid Width="37" Height="36" HorizontalAlignment="Left" VerticalAlignment="Top"
                                              IsHitTestVisible="False">
                                            <Path Data="M 1,1 L 35,1 L 35,24 L 24,35 L 1,35 Z"
                                                  Fill="{StaticResource GoldenMetal}" Stroke="#DCC700" StrokeThickness="1.2"/>
                                            <TextBlock Text="1" Foreground="#061013" FontFamily="{StaticResource Oxanium}"
                                                       FontWeight="ExtraBold" FontSize="23" TextAlignment="Center"
                                                       VerticalAlignment="Center" Margin="0,-1,4,0"/>
                                        </Grid>
                                        <Viewbox x:Name="InstallStageIcon" HorizontalAlignment="Center" Width="58" Height="42"
                                                  IsHitTestVisible="False">
                                             <fx:StageEmblem Kind="Chip" Width="64" Height="64"/>
                                         </Viewbox>
                                    </Grid>
                                    <TextBlock x:Name="StepOneTitle" Grid.Row="1" Margin="0,8,0,0" Text="Install Profilers"
                                               Foreground="#F2F5F5" FontFamily="{StaticResource Oxanium}"
                                               HorizontalAlignment="Stretch" TextAlignment="Center"
                                               FontWeight="Bold" FontSize="15.5" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Margin="0,3,0,0"
                                               Text="Install the CET and REDscript profiling tools."
                                               Foreground="#A8B3B5" FontSize="13"
                                               HorizontalAlignment="Stretch" TextAlignment="Center"
                                               VerticalAlignment="Top" TextWrapping="Wrap"/>
                                    <Button x:Name="InstallButton" Grid.Row="3" Content="INSTALL PROFILERS"
                                            Style="{StaticResource StageActionButton}" Click="Install_Click"
                                            IsEnabled="False"/>
                                </Grid>
                            </Grid>

                            <Grid Grid.Column="1" Margin="24,0,24,0">
                                <fx:ChamferOutline x:Name="StepTwoOutline" Fill="#0B1518"
                                                   Stroke="{StaticResource NeonStroke}" SpatialStroke="True"
                                                   StrokeThickness="2.0" CornerCut="14" IsHitTestVisible="False"/>
                                <Grid Margin="12,10,12,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="38"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid Width="37" Height="36" HorizontalAlignment="Left" VerticalAlignment="Top"
                                              IsHitTestVisible="False">
                                            <Path Data="M 1,1 L 35,1 L 35,24 L 24,35 L 1,35 Z"
                                                  Fill="{StaticResource GoldenMetal}" Stroke="#DCC700" StrokeThickness="1.2"/>
                                            <TextBlock Text="2" Foreground="#061013" FontFamily="{StaticResource Oxanium}"
                                                       FontWeight="ExtraBold" FontSize="23" TextAlignment="Center"
                                                       VerticalAlignment="Center" Margin="0,-1,4,0"/>
                                        </Grid>
                                        <Viewbox x:Name="LaunchStageIcon" HorizontalAlignment="Center" Width="54" Height="39"
                                                  IsHitTestVisible="False">
                                             <fx:StageEmblem Kind="Ignition" Width="80" Height="56"/>
                                         </Viewbox>
                                    </Grid>
                                    <TextBlock x:Name="StepTwoTitle" Grid.Row="1" Margin="0,8,0,0" Text="Start Cyberpunk"
                                               Foreground="#F2F5F5" FontFamily="{StaticResource Oxanium}"
                                               HorizontalAlignment="Stretch" TextAlignment="Center"
                                               FontWeight="Bold" FontSize="15.5" TextWrapping="Wrap"/>
                                    <StackPanel Grid.Row="2" Margin="0,3,0,0"
                                                VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                        <TextBlock Text="Record a varied run: idle, walking, driving and heavy combat. Avoid menus, inventory or pausing the game in any way."
                                                   Foreground="#A8B3B5" FontSize="13"
                                                   HorizontalAlignment="Stretch" TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="StepTwoHotkey" Text="STOP / START — F11"
                                                   Margin="0,6,0,0" Foreground="{StaticResource Cyan}"
                                                   FontFamily="{StaticResource Oxanium}" FontSize="12.5"
                                                   FontWeight="Bold" TextAlignment="Center"
                                                   HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <Button x:Name="LaunchButton" Grid.Row="3" Content="START CYBERPUNK"
                                            Style="{StaticResource StageActionButton}" Click="Launch_Click"
                                            IsEnabled="False"/>
                                </Grid>
                            </Grid>

                            <Grid Grid.Column="2" Margin="24,0,19,0">
                                <fx:ChamferOutline x:Name="StepThreeOutline" Fill="#0B1518"
                                                   Stroke="{StaticResource NeonStroke}" SpatialStroke="True"
                                                   StrokeThickness="2.0" CornerCut="14" IsHitTestVisible="False"/>
                                <Grid Margin="12,10,12,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="38"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid Width="37" Height="36" HorizontalAlignment="Left" VerticalAlignment="Top"
                                              IsHitTestVisible="False">
                                            <Path Data="M 1,1 L 35,1 L 35,24 L 24,35 L 1,35 Z"
                                                  Fill="{StaticResource GoldenMetal}" Stroke="#DCC700" StrokeThickness="1.2"/>
                                            <TextBlock Text="3" Foreground="#061013" FontFamily="{StaticResource Oxanium}"
                                                       FontWeight="ExtraBold" FontSize="23" TextAlignment="Center"
                                                       VerticalAlignment="Center" Margin="0,-1,4,0"/>
                                        </Grid>
                                        <Viewbox x:Name="CollectStageIcon" HorizontalAlignment="Center" Width="58" Height="42"
                                                  IsHitTestVisible="False">
                                             <fx:StageEmblem Kind="Data" Width="64" Height="64"/>
                                         </Viewbox>
                                    </Grid>
                                    <TextBlock x:Name="StepThreeTitle" Grid.Row="1" Margin="0,8,0,0" Text="Collect Results"
                                               Foreground="#F2F5F5" FontFamily="{StaticResource Oxanium}"
                                               HorizontalAlignment="Stretch" TextAlignment="Center"
                                               FontWeight="Bold" FontSize="15.5" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Margin="0,3,0,0"
                                               Text="Close the game. Verify and collect evidence before continuing to Analyze."
                                               Foreground="#A8B3B5" FontSize="13"
                                               HorizontalAlignment="Stretch" TextAlignment="Center"
                                               VerticalAlignment="Top" TextWrapping="Wrap"/>
                                    <Button x:Name="CollectButton" Grid.Row="3" Content="COLLECT RESULTS"
                                            Style="{StaticResource StageActionButton}" Click="Collect_Click"
                                            IsEnabled="False"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Console and recovery never hide behind scrolling content. -->
                <Grid Grid.Row="1" Margin="14,6,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="188"/>
                    </Grid.ColumnDefinitions>
                    <!-- RESTORE reuses the first stage action, not a footer button. -->
                    <Grid x:Name="ConsoleTextHost" Grid.Column="0"
                          Margin="-7,-6,9,4" Background="Transparent">
                        <!-- Restore multiple visible guidance rows; allow scrolling
                             if all five framework gates fail at once. Keep the
                             standard one-line status centered in this space. -->
                        <ScrollViewer Margin="25,0,5,0" MaxHeight="80"
                                      VerticalAlignment="Center"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="StatusText" Foreground="#BFE0E6"
                                       FontSize="12.5" LineHeight="16.5"
                                       TextWrapping="Wrap"
                                       Text="Select the Cyberpunk 2077 game folder."/>
                        </ScrollViewer>
                    </Grid>
                    <Button x:Name="ContinueButton" Grid.Column="1" Content="CONTINUE  →"
                            Margin="-10,-20,10,20"
                            Style="{StaticResource ContinueStyle}" Click="Continue_Click"
                            IsEnabled="False"/>
                </Grid>

                <Grid x:Name="ResultsPage" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                      Background="#000000" Margin="0,3,0,3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}"
                                   BasedOn="{StaticResource NeonScrollBar}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Margin="18,16">
                            <TextBlock Text="ANALYZE &amp; OPTIMIZE" Foreground="#FFF000"
                                       FontFamily="{StaticResource Oxanium}"
                                       FontSize="23" FontWeight="ExtraBold"/>
                            <TextBlock x:Name="ResultsStatusText" Foreground="#00E2F2"
                                       TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0"/>
                            <Grid Margin="0,12,0,0">
                                <fx:ChamferOutline Fill="#081012" Stroke="#36535B"
                                                   StrokeThickness="2.0" CornerCut="14"
                                                   IsHitTestVisible="False"/>
                                <StackPanel Margin="12">
                                    <TextBlock Text="CET   /   LUA  ·  NATIVE  ·  G-GC"
                                               Foreground="#FFF000" FontFamily="{StaticResource Oxanium}"
                                               FontWeight="Bold" FontSize="14"/>
                                    <TextBox x:Name="CetReportText" Text="No verified CET capture analyzed."
                                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                             Background="#081012" Foreground="#B7CED6" BorderThickness="0"
                                             MinHeight="70" Margin="0,7,0,0"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <fx:ChamferOutline Fill="#081012" Stroke="#36535B"
                                                   StrokeThickness="2.0" CornerCut="14"
                                                   IsHitTestVisible="False"/>
                                <StackPanel Margin="12">
                                    <TextBlock Text="REDscript  /  CALLSITES  ·  COMPILATION"
                                               Foreground="#FFF000" FontFamily="{StaticResource Oxanium}"
                                               FontWeight="Bold" FontSize="14"/>
                                    <TextBox x:Name="RedReportText" Text="No verified REDscript capture analyzed."
                                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                             Background="#081012" Foreground="#B7CED6" BorderThickness="0"
                                             MinHeight="70" Margin="0,7,0,0"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="AnalyzeButton" Grid.Column="0" Content="ANALYZE"
                                        Style="{StaticResource ActionButton}" IsEnabled="False" Margin="0,0,4,0"/>
                                <Button x:Name="GenerateButton" Grid.Column="1" Content="GENERATE ZIP"
                                        Style="{StaticResource ActionButton}" IsEnabled="False" Margin="4,0,4,0"/>
                                <Button x:Name="OpenResultsButton" Grid.Column="2" Content="OPEN RESULTS"
                                        Style="{StaticResource ActionButton}" IsEnabled="False"
                                        Margin="4,0,0,0" Click="OpenResults_Click"/>
                            </Grid>
                            <TextBlock Text="Generation remains disabled until source-aware CET and REDscript compilation checks pass."
                                       Foreground="#98A9B1" TextWrapping="Wrap" FontSize="12"
                                       Margin="3,9,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- The entire V is below the thin inner frame: leave its yellow
             outline visible. ONLY the owner RGBA bottom puddle strip above
             it may cross the line. The original outer raster stays topmost. -->
        <fx:ContentChassisOutline Grid.RowSpan="2" HeaderHeight="68"
                                  Panel.ZIndex="13" FrameInset="27"
                                  Stroke="{StaticResource NeonStroke}" SpatialStroke="True"
                                  IsHitTestVisible="False"/>

        <!-- Directly register the owner's 365x49 crop with the V 482x928
             source. The strip has its own transparency; no generated mask. -->
        <Grid x:Name="PuddleOverflowHost" Grid.Row="1" Panel.ZIndex="14"
              Width="248" Height="34" HorizontalAlignment="Left"
              VerticalAlignment="Bottom" Margin="28,0,0,23"
              IsHitTestVisible="False" ClipToBounds="True">
            <Image x:Name="PuddleOverflowImage" Stretch="Uniform"
                   StretchDirection="Both" HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>


    </Grid>
</Window>
